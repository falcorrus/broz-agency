---
// src/components/en/AboutEn.astro
---

<section id="about" class="py-28 px-6 bg-background relative overflow-hidden">
  <!-- Subtle Ambient Light -->
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-500/5 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left Info Column -->
      <div>
        <div class="mono-tag text-emerald-400 mb-3 font-semibold">[02] ABOUT US</div>
        <h2 class="text-4xl md:text-6xl font-extrabold neo-heading uppercase mb-8 text-white tracking-tight leading-tight">
          WHY PARTNER WITH <br /><span class="text-gradient-emerald">BROZ AGENCY</span>
        </h2>
        
        <p class="text-slate-400 text-lg leading-relaxed mb-10 max-w-xl font-normal">
          "We don't just write code — we architect high-speed digital assets that deliver measurable ROI and zero downtime."
        </p>
        
        <div class="space-y-6">
          <div class="reveal neo-card p-6 flex gap-5 items-start">
            <div class="w-12 h-12 bg-emerald-500/10 rounded-lg flex items-center justify-center border border-emerald-500/30 shrink-0 text-emerald-400 font-mono font-bold">
              01
            </div>
            <div>
              <h3 class="text-white font-bold neo-heading text-lg mb-1">Business Intelligence</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Engineers with strong computer science & economics backgrounds. We craft software built to scale your business bottom line.</p>
            </div>
          </div>

          <div class="reveal neo-card p-6 flex gap-5 items-start" style="transition-delay: 100ms">
            <div class="w-12 h-12 bg-emerald-500/10 rounded-lg flex items-center justify-center border border-emerald-500/30 shrink-0 text-emerald-400 font-mono font-bold">
              02
            </div>
            <div>
              <h3 class="text-white font-bold neo-heading text-lg mb-1">Community Expertise</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Organizers of the @flutterflow_rus developer community. Pushing front-line standards in mobile and web architecture.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Bento Column -->
      <div class="relative h-[480px]">
        <div class="grid grid-cols-2 grid-rows-2 gap-4 h-full">
          <!-- Bento Box 1 -->
          <div class="neo-card p-6 flex flex-col justify-between relative overflow-hidden group">
            <div class="mono-tag text-slate-500">VELOCITY // 99+</div>
            <h3 class="text-3xl font-extrabold text-white uppercase neo-heading">Fast.</h3>
            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-ping"></div>
          </div>

          <!-- Bento Box 2 -->
          <div class="neo-card p-6 flex flex-col justify-between relative overflow-hidden group">
            <div class="mono-tag text-slate-500">QUALITY // CODE</div>
            <h3 class="text-3xl font-extrabold text-emerald-400 uppercase neo-heading">Robust.</h3>
            <div class="mono-tag text-slate-400 text-[10px]">ZERO TECH DEBT</div>
          </div>

          <!-- Bento Main Box 3 -->
          <div class="col-span-2 neo-card p-8 flex flex-col justify-between relative overflow-hidden group border-emerald-500/30">
            <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
            
            <div class="flex justify-between items-start">
              <div>
                <div class="mono-tag text-emerald-400 mb-1">ARCHITECTURE</div>
                <h3 class="text-5xl font-extrabold text-white uppercase neo-heading">Flexible.</h3>
              </div>
              <span class="px-2.5 py-1 bg-emerald-500/10 border border-emerald-500/30 rounded text-[10px] font-mono text-emerald-400">AUTONOMOUS</span>
            </div>

            <p class="text-xs text-slate-400 max-w-sm mt-4 font-normal leading-relaxed">
              We pivot to emerging market needs faster than you can update your roadmap. Complete IP transfer and clean documentation included.
            </p>
          </div>
        </div>

        <!-- Metric Badge -->
        <div class="absolute -bottom-4 -right-4 p-5 neo-card bg-[#18181c] shadow-2xl border-emerald-500/40 reveal" style="transition-delay: 300ms">
          <div class="text-3xl font-black text-emerald-400 font-mono">100%</div>
          <div class="mono-tag text-slate-400 text-[9px] mt-1">OWNERSHIP OF RESULTS</div>
        </div>
      </div>
    </div>
  </div>
</section>
