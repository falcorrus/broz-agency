---
// src/components/en/HeroEn.astro
import WaveText from '../WaveText';
---

<section class="relative min-h-[92vh] flex flex-col items-center justify-center px-6 overflow-hidden pt-28 pb-16">
  <!-- Neo Grid Background & Ambient Lighting -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_20%,#000_60%,transparent_100%)]"></div>
    <!-- Emerald Ambient Glow -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-500/10 rounded-full blur-[140px] pointer-events-none"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto text-center">
    <!-- Status & Monospace Pill -->
    <div class="reveal inline-flex items-center gap-3 px-4 py-1.5 rounded-full border border-emerald-500/30 bg-[#131316] mb-8 shadow-[0_0_20px_rgba(16,185,129,0.15)]">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span class="mono-tag text-emerald-400 font-bold">STATUS // ACCEPTING PROJECTS</span>
    </div>

    <!-- Main Kinetic Headline -->
    <h1 class="text-5xl md:text-8xl lg:text-[105px] font-extrabold tracking-tighter mb-8 leading-[0.92] uppercase neo-heading text-white">
      WE TRANSFORM CODE <br />
      <span class="text-gradient-emerald inline-block">
        <WaveText client:load texts={["INTO REVENUE.", "INTO ASSETS.", "INTO GROWTH."]} />
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
      High-velocity digital engineering powered by <span class="text-white font-semibold">Astro, React & Flutter</span>. Autonomous workflows & seamless mobile scale.
    </p>

    <!-- CTAs -->
    <div class="reveal flex flex-col sm:flex-row items-center justify-center gap-4" style="transition-delay: 200ms">
      <a 
        href="#contact" 
        class="px-8 py-4 btn-emerald text-sm uppercase font-bold tracking-wider rounded-lg active:scale-95 w-full sm:w-auto text-center shadow-[0_0_25px_rgba(16,185,129,0.3)]"
      >
        Start Project →
      </a>
      <a 
        href="#portfolio" 
        class="px-8 py-4 btn-outline-neo text-sm uppercase font-bold tracking-wider rounded-lg active:scale-95 w-full sm:w-auto text-center"
      >
        Explore Work
      </a>
    </div>

    <!-- Quick Stats Grid -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto text-left">
      <div class="neo-card p-4">
        <div class="mono-tag text-slate-500 mb-1">01 / STACK</div>
        <div class="text-sm font-bold text-white uppercase">Astro 6 & React 19</div>
      </div>
      <div class="neo-card p-4">
        <div class="mono-tag text-slate-500 mb-1">02 / PERFORMANCE</div>
        <div class="text-sm font-bold text-emerald-400 uppercase">99+ Lighthouse</div>
      </div>
      <div class="neo-card p-4">
        <div class="mono-tag text-slate-500 mb-1">03 / MOBILE</div>
        <div class="text-sm font-bold text-white uppercase">Flutter & Native</div>
      </div>
      <div class="neo-card p-4">
        <div class="mono-tag text-slate-500 mb-1">04 / AUTOMATION</div>
        <div class="text-sm font-bold text-emerald-400 uppercase">n8n & AI Agents</div>
      </div>
    </div>
  </div>
</section>
