---
// src/components/en/PortfolioEn.astro
import { PortfolioGrid } from '../PortfolioGrid';
import { projectsEn } from '../../data/projects';
---

<section id="portfolio" class="py-28 px-6 bg-background relative overflow-hidden">
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <div class="mono-tag text-emerald-400 mb-3 font-semibold">[03] PORTFOLIO & WORK</div>
        <h2 class="text-4xl md:text-6xl font-extrabold neo-heading uppercase text-white tracking-tight">
          FEATURED <span class="text-gradient-emerald">CASES</span>
        </h2>
      </div>
      <p class="text-slate-400 text-base max-w-md font-normal leading-relaxed">
        Production-ready products with transparent budgets & timelines: from 48h MVPs to complex enterprise systems.
      </p>
    </div>

    <!-- Interactive Portfolio Grid with Budget Filter -->
    <PortfolioGrid client:visible projects={projectsEn} lang="en" />
  </div>
</section>
