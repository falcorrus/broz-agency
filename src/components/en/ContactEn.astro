---
// src/components/en/ContactEn.astro
---

<section id="contact" class="py-28 px-6 bg-background relative overflow-hidden">
  <!-- Emerald Ambient Glow -->
  <div class="absolute bottom-0 right-1/2 translate-x-1/2 w-[600px] h-[300px] bg-emerald-500/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto text-center relative z-10">
    <div class="mono-tag text-emerald-400 mb-3 font-semibold">[05] CONTACT & INITIATION</div>
    <h2 class="text-4xl md:text-7xl font-extrabold neo-heading uppercase mb-6 text-white tracking-tight leading-tight">
      READY TO BUILD <br />
      <span class="text-gradient-emerald">YOUR PRODUCT?</span>
    </h2>
    <p class="text-slate-400 text-lg max-w-xl mx-auto mb-12 font-normal leading-relaxed">
      Reach out directly. We will review your goals, architect the optimal tech stack, and deliver clear timelines.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
      <a 
        href="https://t.me/brozaurus" 
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-8 py-4 btn-emerald text-sm font-bold uppercase tracking-wider rounded-lg active:scale-95 flex items-center justify-center gap-3 shadow-[0_0_25px_rgba(16,185,129,0.3)]"
      >
        <span>Telegram: @brozaurus</span> →
      </a>
      
      <a 
        href="https://wa.me/5548992012727" 
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-8 py-4 btn-outline-neo text-sm font-bold uppercase tracking-wider rounded-lg active:scale-95 flex items-center justify-center gap-3"
      >
        <span>WhatsApp</span>
      </a>
    </div>

    <!-- Neo Footer -->
    <footer class="pt-10 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-500">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span class="text-slate-300 font-bold uppercase">BROZ.AGENCY // 2026</span>
      </div>
      <div>
        <span>ASTRO 6 • FLUTTER • SUPABASE • AI AGENTS</span>
      </div>
    </footer>
  </div>
</section>
