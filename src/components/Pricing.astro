---
// src/components/Pricing.astro

const plans = [
  {
    num: "01",
    name: "Старт / Landing MVP",
    price: "$500 - $1500",
    description: "Быстрый запуск промо-страниц, лендингов и гипотез.",
    features: [
      "<b>Объем:</b> лендинг или MVP до 5 экранов/страниц.",
      "<b>Дизайн:</b> Адаптивный UI/UX под брендбук.",
      "<b>Формы:</b> интеграция заявок в Telegram / Email / Sheets.",
      "<b>Инфраструктура:</b> SEO-оптимизация, деплой Vercel/Beget.",
      "<b>Сроки:</b> от 48 до 96 часов."
    ],
    highlight: false,
    cta: "Заказать MVP"
  },
  {
    num: "02",
    name: "Growth / Full Product",
    price: "$3000 - $5000",
    description: "Для запуска полноценного SaaS, маркетплейса или веб-сервиса.",
    features: [
      "<b>Объем:</b> многостраничное SPA/PWA приложение (до 15 экранов).",
      "<b>UX/UI:</b> кастомный дизайн-код и система компонентов.",
      "<b>Backend:</b> Supabase БД, Auth авторизация, интеграция оплат.",
      "<b>Аналитика:</b> GA4, события, отслеживание воронки конверсии.",
      "<b>Гарантия:</b> 1 месяц поддержки и багфикса."
    ],
    highlight: true,
    cta: "Запустить Продукт"
  },
  {
    num: "03",
    name: "Advanced / AI Integration",
    price: "от $5000",
    description: "Оптимизация расходов и внедрение искусственного интеллекта.",
    features: [
      "<b>Аудит:</b> полный разбор процессов компании.",
      "<b>AI-интеграции:</b> внедрение LLM (Gemini/OpenAI) под задачи.",
      "<b>Автоматизация:</b> автономные воркфлоу на n8n.",
      "<b>AI-агенты:</b> умные Telegram-боты с базой знаний (RAG).",
      "<b>Поддержка:</b> до 3 месяцев гарантии."
    ],
    highlight: false,
    cta: "Обсудить AI"
  }
];
---

<section id="pricing" class="py-28 px-6 bg-background relative overflow-hidden">
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-20">
      <div class="mono-tag text-emerald-400 mb-3 font-semibold">[04] TRANSPARENT PRICING</div>
      <h2 class="text-4xl md:text-6xl font-extrabold neo-heading uppercase text-white tracking-tight mb-4">
        Прозрачная <span class="text-gradient-emerald">Стоимость</span>
      </h2>
      <p class="text-slate-400 text-base max-w-xl mx-auto font-normal">
        Фиксированная смета до начала работ. Никаких скрытых платежей.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      {plans.map((plan, index) => (
        <div 
          class:list={[
            "reveal neo-card p-8 flex flex-col relative transition-all duration-300",
            { "border-emerald-500/60 bg-[#18181c] shadow-[0_0_40px_rgba(16,185,129,0.2)] md:-translate-y-2": plan.highlight }
          ]}
          style={`transition-delay: ${index * 120}ms`}
        >
          {plan.highlight && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-emerald-500 text-slate-950 font-mono text-[10px] font-extrabold uppercase tracking-widest px-4 py-1 rounded-full shadow-lg">
              MOST POPULAR
            </div>
          )}
          
          <div class="mb-8">
            <div class="flex items-center justify-between mb-2">
              <span class="mono-tag text-emerald-400 font-bold">{plan.num} // PLAN</span>
            </div>
            <h3 class="text-2xl font-extrabold neo-heading text-white uppercase mb-4">{plan.name}</h3>
            <div class="text-3xl md:text-4xl font-extrabold font-mono text-white mb-4 tracking-tight">{plan.price}</div>
            <p class="text-slate-400 text-xs leading-relaxed font-normal">{plan.description}</p>
          </div>

          <ul class="space-y-3.5 mb-10 flex-1 border-t border-white/10 pt-6">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3 text-xs text-slate-300 font-normal">
                <span class="text-emerald-400 font-bold shrink-0">✓</span>
                <span set:html={feature} />
              </li>
            ))}
          </ul>

          <a 
            href="#contact" 
            class:list={[
              "w-full py-3.5 text-xs uppercase tracking-wider font-bold rounded-lg text-center transition-all active:scale-95",
              plan.highlight 
                ? "btn-emerald" 
                : "btn-outline-neo"
            ]}
          >
            {plan.cta} →
          </a>
        </div>
      ))}
    </div>

    <div class="mt-14 text-center text-xs font-mono text-slate-500 max-w-2xl mx-auto">
      * Стоимость и инфраструктура согласовываются заранее. Прозрачные этапы и отчетность.
    </div>
  </div>
</section>
