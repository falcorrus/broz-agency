---
// src/components/Header.astro
const { lang = 'ru' } = Astro.props;

const navItems = lang === 'ru' ? [
  { label: 'О нас', id: 'about' },
  { label: 'Метод', id: 'process' },
  { label: 'Цены', id: 'pricing' },
  { label: 'Кейсы', id: 'portfolio' }
] : [
  { label: 'About', id: 'about' },
  { label: 'Method', id: 'process' },
  { label: 'Pricing', id: 'pricing' },
  { label: 'Cases', id: 'portfolio' }
];

const ctaText = lang === 'ru' ? 'Связаться' : 'Get in Touch';
---

<header id="main-header" class="fixed top-5 left-1/2 -translate-x-1/2 w-[95%] max-w-7xl z-50 transition-all duration-300 rounded-xl border border-white/10 bg-[#0a0a0c]/80 backdrop-blur-xl">
  <div class="px-6 py-3.5 flex items-center justify-between">
    <!-- Logo -->
    <a href={lang === 'ru' ? '/' : '/en/'} class="flex items-center gap-3 group">
      <div class="relative w-8 h-8 flex items-center justify-center bg-[#131316] border border-emerald-500/40 rounded-lg group-hover:border-emerald-400 transition-colors">
        <span class="font-mono text-emerald-400 font-bold text-base group-hover:scale-110 transition-transform">B</span>
      </div>
      <span class="text-base neo-heading tracking-tight text-white">
        Broz<span class="text-emerald-400 ml-1">.Agency</span>
      </span>
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <a 
          href={`#${item.id}`} 
          class="mono-tag text-slate-400 hover:text-emerald-400 transition-colors relative group py-1"
        >
          {item.label}
          <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-emerald-400 transition-all duration-300 group-hover:w-full"></span>
        </a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-4">
      <!-- Language Selector -->
      <button 
        id="lang-toggle" 
        class="px-3 py-1.5 border border-white/10 hover:border-emerald-500/50 rounded-md font-mono text-xs font-semibold uppercase tracking-wider text-slate-300 hover:text-white cursor-pointer transition-all active:scale-95 bg-[#131316]"
        aria-label="Toggle language"
      >
        {lang === 'ru' ? 'EN' : 'RU'}
      </button>

      <!-- CTA Button -->
      <a href="#contact" class="hidden sm:inline-flex px-5 py-2 btn-emerald text-xs uppercase tracking-wider font-bold rounded-md active:scale-95">
        {ctaText} →
      </a>
    </div>
  </div>
</header>

<script is:inline define:vars={{ currentLang: lang }}>
  const langToggle = document.getElementById('lang-toggle');
  if (langToggle) {
    langToggle.addEventListener('click', () => {
      const nextLang = currentLang === 'ru' ? 'en' : 'ru';
      localStorage.setItem('lang', nextLang);
      
      if (nextLang === 'en') {
        window.location.href = '/en/';
      } else {
        window.location.href = '/';
      }
    });
  }
</script>
